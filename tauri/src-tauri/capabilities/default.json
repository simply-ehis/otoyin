{
  "identifier": "default",
  "description": "Default capability for the main window - core + dialog/fs/shell/process/updater plugin access. Write scope deliberately excludes $HOME/** (export targets live in user content folders).",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "dialog:default",
    "fs:default",
    "process:default",
    "shell:default",
    "updater:default",
    "fs:allow-write-file",
    "fs:allow-write-text-file",
    {
      "identifier": "fs:scope",
      "allow": [
        { "path": "$DESKTOP/**" },
        { "path": "$DOWNLOAD/**" },
        { "path": "$DOCUMENT/**" },
        { "path": "$AUDIO/**" },
        { "path": "$VIDEO/**" },
        { "path": "$PICTURES/**" }
      ]
    }
  ]
}
