{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Otoyin Studio",
  "version": "0.1.0",
  "identifier": "com.21labs.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist",
    "devUrl": "http://localhost:21132"
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "resources": {
      "binaries/otoyin-server/": "otoyin-server/"
    },
    "windows": {
      "nsis": {
        "displayLanguageSelector": true,
        "languages": ["English", "German", "Spanish", "French", "PortugueseBR", "Korean"],
        "installerIcon": "icons/icon.ico",
        "headerImage": "icons/128x128.png",
        "sidebarImage": "icons/128x128.png",
        "installMode": "both",
        "compression": "lzma"
      },
      "wix": {
        "language": ["en-US", "de-DE", "es-ES", "fr-FR", "pt-BR", "ko-KR"]
      }
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/256x256.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "frameworks": [],
      "minimumSystemVersion": "11.0"
    }
  },
  "app": {
    "macOSPrivateApi": true,
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost http://localhost:*; font-src 'self' data:",
      "capabilities": ["default"]
    },
    "windows": [
      {
        "title": "Otoyin Studio",
        "width": 1400,
        "height": 900,
        "minWidth": 800,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false,
        "userAgent": null,
        "decorations": false,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true
      }
    ],
    "withGlobalTauri": false
  },
  "plugins": {
    "shell": {
      "open": "^(https?|tauri):.*"
    },
    "updater": {
      "endpoints": [
        "https://github.com/21-labs/21-labs/releases/latest/download/latest.json"
      ],
      "pubkey": "jMxgDJGUeOfS62+WZhrVK2Vo0j5UkOnS1w9QhoP7KX4="
    }
  }
}
