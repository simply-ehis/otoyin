{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Otoyin Studio",
  "version": "0.1.0",
  "identifier": "com.otoyin.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist",
    "devUrl": "http://localhost:21132"
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "createUpdaterArtifacts": true,
    "resources": {
      "binaries/otoyin-server/": "otoyin-server/"
    },
    "externalBin": ["binaries/otoyin-server/otoyin-server"],
    "windows": {
      "nsis": {
        "displayLanguageSelector": true,
        "languages": ["English", "German", "Spanish", "French", "PortugueseBR", "Korean"],
        "installerIcon": "icons/icon.ico",
        "headerImage": "icons/installer-header.bmp",
        "sidebarImage": "icons/installer-sidebar.bmp",
        "installMode": "both",
        "compression": "lzma"
      },
      "wix": {
        "language": "en-US"
      }
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/256x256.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "frameworks": [],
      "minimumSystemVersion": "11.0"
    }
  },
  "app": {
    "macOSPrivateApi": true,
    "security": {
      "csp": "default-src 'self' blob: data: media:; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' blob: data:; media-src 'self' blob: data: media:; connect-src 'self' ipc: http://ipc.localhost http://localhost:*; font-src 'self' data:",
      "capabilities": ["default"]
    },
    "windows": [
      {
        "title": "Otoyin Studio",
        "width": 1280,
        "height": 800,
        "minWidth": 800,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false,
        "center": true,
        "userAgent": null,
        "decorations": false,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true
      }
    ],
    "withGlobalTauri": false
  },
  "plugins": {
    "shell": {
      "open": "^(https?|tauri):.*"
    },
"updater": {
      "endpoints": [
        "https://github.com/simply-ehis/otoyin/releases/latest/download/latest.json"
      ],
      "pubkey": "RWSIdWY+0cF8oY6C3N64HUEgpmdw5AZylfGELXBdC7ojOCIGCSGpc+Bd"
    }
  }
}
