__pycache__/
*.pyc
*.pyo
.pytest_cache/
.ruff_cache/
.mypy_cache/

# ── Build artifacts ─────────────────────────────────────────────────────
dist/
build/
*.egg-info/
*.spec

# ── Logs and temp files ─────────────────────────────────────────────────
*.log
*.tmp
*.temp
*.bak
logs/

