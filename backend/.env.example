# ── Stripe Configuration ────────────────────────────────────────────────
# Get test keys from https://dashboard.stripe.com/test/apikeys
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# Optional: map product IDs to pre-configured Stripe Price IDs
# If empty, checkout uses dynamic pricing (creates prices on-the-fly)
# STRIPE_PRICE_MAP={"qwen3-8-27b-ud-iq2-s": "price_1234", "lfm2": "price_5678"}

# ── License Signing ────────────────────────────────────────────────────
# HMAC-SHA256 key for signing licenses (used for offline verification)
LICENSE_SIGNING_KEY=change-this-to-a-random-secret

# ── Currency Conversion ────────────────────────────────────────────────
# exchangerate.dev free tier: 10,000 req/mo (no key needed for free tier)
# EXCHANGE_RATE_API_KEY=your-key-here

# ── Development ────────────────────────────────────────────────────────
# Set to "1" to enable Stripe dev mode (simulates payments without real Stripe)
# STRIPE_DEV_MODE=1
