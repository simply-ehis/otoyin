# Marketplace server
set dotenv-load

# Install dependencies
[private]
install:
    pip install -e ".[dev]"

# Run the dev server
[private]
dev _ensure-venv:
    python -m uvicorn marketplace_server.app:app --reload --port 8420

# Seed the database with initial products
[private]
seed _ensure-venv:
    python -m marketplace_server.seed

# Run tests
[private]
test _ensure-venv:
    pytest tests/ -v

# Lint
[private]
lint:
    ruff check .
    ruff format --check .

# Lint + fix
[private]
fmt:
    ruff check --fix .
    ruff format .
