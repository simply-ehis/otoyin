{
  "servers": {
    "paddle-sandbox": {
      "type": "http",
      "url": "https://sandbox-mcp.paddle.com/mcp",
      "headers": {
        "Authorization": "Bearer ${env:PADDLE_SANDBOX_API_KEY}"
      }
    },
    "21-labs": {
      "type": "stdio",
      "command": "21-labs-mcp",
      "env": {
        "TWENTYLABS_MCP_TRANSPORT": "stdio"
      }
    }
  }
}
