[TEMPLATE]
# Otoyin environment variables
# Copy this to .env and adjust values for your setup.
# Most of these have sane defaults and are NOT required for normal use.
# Legacy TWENTYLABS_* / TWENTYONE_LABS_* names are still honored as fallbacks.

# --- Server ---
# OTOYIN_HOST=127.0.0.1               # Host to bind (default 127.0.0.1)
# OTOYIN_PORT=17493                   # Port to bind (default 17493)
# OTOYIN_CORS_ORIGINS=                # Extra CORS origins (comma-separated)
# OTOYIN_LOG_FORMAT=                  # Log format override

# --- Remote notices (push-style announcements) ---
# OTOYIN_NOTICES_URL=                 # GET /v1/notices on the marketplace service (disabled when unset)
# OTOYIN_NOTICES_TIMEOUT_S=5          # Notices fetch timeout in seconds

# --- Remote catalog (signed, verified, offline-first) ---
# OTOYIN_CATALOG_URL=                 # GET /v1/catalog (signed) on the marketplace service (disabled when unset)
# OTOYIN_CATALOG_TIMEOUT_S=8          # Catalog fetch timeout in seconds
# OTOYIN_CATALOG_REFRESH_S=86400      # Remote catalog refresh interval in seconds (default 24h)

# --- Models ---
# OTOYIN_MODELS_DIR=                  # Override HuggingFace model cache dir

# --- Security / licensing ---
# LICENSE_SIGNING_KEY=                # License signing key (HMAC/Ed25519)
# TWENTYLABS_SECRET=                  # Fernet master key (auto-generated if unset)

# --- API keys ---
# FREESOUND_API_KEY=                  # Freesound v2 API token

# --- MCP shim (stdio clients) ---
# OTOYIN_CLIENT_ID=                   # Client ID forwarded to server (legacy TWENTYONE_LABS_CLIENT_ID)

# --- Backend ---
# TWENTYONE_LABS_BACKEND_VARIANT=cpu  # cuda or cpu (auto-detected at startup)
# TWENTYONE_LABS_OFFLINE_PATCH=       # Enable offline HF patch

# --- Plugins ---
# VST3_USER_PATH=                     # VST3 plugin search path (user)
# VST3_SYSTEM_PATH=                   # VST3 plugin search path (system)

# --- AMD ROCm ---
# HSA_OVERRIDE_GFX_VERSION=           # AMD GPU GFX version override
# MIOPEN_LOG_LEVEL=                   # MIOpen log level