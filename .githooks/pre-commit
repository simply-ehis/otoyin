#!/bin/bash
# Pre-commit gate: fast checks in parallel, then tests sequentially.
# Uses local node_modules binaries to avoid cold-start.
# bash-only, no pwsh dependency.
set -uo pipefail

root="$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)"
failed=0

echo ""
echo "=== 21-labs Pre-Commit Gate ==="
echo ""

# Use venv python when available
PY="python"
if [ -f "$root/backend/venv/Scripts/python.exe" ]; then PY="$root/backend/venv/Scripts/python.exe"
elif [ -f "$root/backend/venv/bin/python" ]; then PY="$root/backend/venv/bin/python"
fi
RUFF="ruff"
if [ -f "$root/backend/venv/Scripts/ruff.exe" ]; then RUFF="$root/backend/venv/Scripts/ruff.exe"
elif [ -f "$root/backend/venv/bin/ruff" ]; then RUFF="$root/backend/venv/bin/ruff"
fi

# Use local binaries from node_modules (avoids bunx/npx cold-start)
BIOME="$root/node_modules/.bin/biome"
TSC="$root/node_modules/.bin/tsc"
# Vitest lives in app/node_modules — run from app/ dir so setupFiles resolve
VITEST="$root/app/node_modules/.bin/vitest"

# Fall back to npx if local binaries don't exist
if [ ! -x "$BIOME" ]; then BIOME="npx @biomejs/biome"; fi
if [ ! -x "$TSC" ]; then TSC="npx tsc"; fi
if [ ! -x "$VITEST" ]; then VITEST="npx vitest"; fi

tmpdir=$(mktemp -d)
trap 'rm -rf "$tmpdir"' EXIT

# ═══════════════════════════════════════════════════════════════════
# Phase 1: Fast checks IN PARALLEL
# ═══════════════════════════════════════════════════════════════════

echo "Phase 1: Fast checks (parallel)..."

# [1] Biome lint
(
  cd "$root" && $BIOME lint app/src 2>&1 | tail -10
  echo $? > "$tmpdir/biome.rc"
) > "$tmpdir/biome.log" 2>&1 &
pid_biome=$!

# [2] TypeScript typecheck (use precommit tsconfig — excludes test files)
(
  cd "$root/app" && $TSC --noEmit -p tsconfig.precommit.json 2>&1 | tail -10
  echo $? > "$tmpdir/tsc.rc"
) > "$tmpdir/tsc.log" 2>&1 &
pid_tsc=$!

# [3] Ruff lint + format
(
  cd "$root" && rc=0
  $RUFF check backend 2>&1 | tail -5 || rc=1
  $RUFF format --check backend 2>&1 | tail -5 || rc=1
  echo $rc > "$tmpdir/ruff.rc"
) > "$tmpdir/ruff.log" 2>&1 &
pid_ruff=$!

# [4] Each static check runs in its own subshell (parallel + isolated imports)
#    Each has a 30s timeout so one slow check doesn't block the rest.
(
  cd "$root" && timeout 30 $PY -X utf8 -m backend.scripts.check_async_blocking backend/routes 2>&1 | tail -3
  echo $? > "$tmpdir/async.rc"
) > "$tmpdir/async.log" 2>&1 &
pid_async=$!

(
  cd "$root" && timeout 30 $PY -c "import sys; sys.path.insert(0,'.'); from backend.scripts.check_name_map import main; sys.exit(main())" 2>&1 | tail -3
  echo $? > "$tmpdir/namemap.rc"
) > "$tmpdir/namemap.log" 2>&1 &
pid_namemap=$!

(
  cd "$root" && timeout 30 $PY -c "import sys; sys.path.insert(0,'.'); from backend.scripts.check_assistant_tools import main; sys.exit(main())" 2>&1 | tail -3
  echo $? > "$tmpdir/assist.rc"
) > "$tmpdir/assist.log" 2>&1 &
pid_assist=$!

(
  cd "$root" && timeout 15 $PY -c "import sys; sys.path.insert(0,'.'); from backend.scripts.check_placeholders import main; sys.exit(main())" 2>&1 | tail -3
  echo $? > "$tmpdir/placeholders.rc"
) > "$tmpdir/placeholders.log" 2>&1 &
pid_placeholders=$!

# [5] Python syntax check (staged files only)
(
  cd "$root" && rc=0
  staged_py=$(git diff --cached --name-only --diff-filter=ACM -- '*.py' 2>/dev/null | head -20)
  if [ -n "$staged_py" ]; then
    for f in $staged_py; do
      if [ -f "$f" ]; then
        $PY -c "import py_compile; py_compile.compile('$f', doraise=True)" 2>/dev/null || rc=1
      fi
    done
  fi
  echo $rc > "$tmpdir/import.rc"
) > "$tmpdir/import.log" 2>&1 &
pid_import=$!

# [6] Encoding: no invalid UTF-8 bytes or U+FFFD in staged text files
#     (timeout generous: I/O-bound, and large rebuild commits stage 400+ files
#     while nine other checks run in parallel — 30s caused timing false-positives)
(
  cd "$root" && timeout 120 $PY -X utf8 scripts/check-encoding.py --staged 2>&1 | tail -15
  echo $? > "$tmpdir/mojibake.rc"
) > "$tmpdir/mojibake.log" 2>&1 &
pid_mojibake=$!

# [10] Report headers: every docs/reports file carries the Date/Status/
#      Last-verified convention (see docs/reports/README.md). Whole-tree:
#      reports change rarely and the scan is trivially fast.
(
  cd "$root" && timeout 15 $PY -X utf8 scripts/check-report-headers.py 2>&1 | tail -10
  echo $? > "$tmpdir/reportheaders.rc"
) > "$tmpdir/reportheaders.log" 2>&1 &
pid_reportheaders=$!

# [11] Dual-instance hazards: no stateful module with a same-stem twin, no
#      split-brain ui-tree imports (the toast-store bug class).
(
  cd "$root" && timeout 60 $PY -X utf8 scripts/check-dual-instances.py 2>&1 | tail -10
  echo $? > "$tmpdir/dualinst.rc"
) > "$tmpdir/dualinst.log" 2>&1 &
pid_dualinst=$!

# Wait for ALL fast checks
wait $pid_biome 2>/dev/null
wait $pid_tsc 2>/dev/null
wait $pid_ruff 2>/dev/null
wait $pid_async 2>/dev/null
wait $pid_namemap 2>/dev/null
wait $pid_assist 2>/dev/null
wait $pid_placeholders 2>/dev/null
wait $pid_import 2>/dev/null
wait $pid_mojibake 2>/dev/null
wait $pid_reportheaders 2>/dev/null
wait $pid_dualinst 2>/dev/null

# Report fast check results
biome_rc=$(cat "$tmpdir/biome.rc" 2>/dev/null || echo 1)
tsc_rc=$(cat "$tmpdir/tsc.rc" 2>/dev/null || echo 1)
ruff_rc=$(cat "$tmpdir/ruff.rc" 2>/dev/null || echo 1)
async_rc=$(cat "$tmpdir/async.rc" 2>/dev/null || echo 1)
namemap_rc=$(cat "$tmpdir/namemap.rc" 2>/dev/null || echo 1)
assist_rc=$(cat "$tmpdir/assist.rc" 2>/dev/null || echo 1)
placeholders_rc=$(cat "$tmpdir/placeholders.rc" 2>/dev/null || echo 1)
import_rc=$(cat "$tmpdir/import.rc" 2>/dev/null || echo 1)
mojibake_rc=$(cat "$tmpdir/mojibake.rc" 2>/dev/null || echo 1)
reportheaders_rc=$(cat "$tmpdir/reportheaders.rc" 2>/dev/null || echo 1)
dualinst_rc=$(cat "$tmpdir/dualinst.rc" 2>/dev/null || echo 1)

for check in biome:Biome tsc:TypeScript ruff:Ruff async:Async-BLocking namemap:NAME_MAP assist:Assistant-Tools placeholders:Placeholders import:Python-Import mojibake:Encoding reportheaders:Report-Headers dualinst:Dual-Instances; do
  name="${check#*:}"
  key="${check%%:*}"
  rc_var="${key}_rc"
  rc="${!rc_var}"
  if [ "$rc" -eq 0 ]; then
    echo "  ✅ $name OK"
  else
    echo "  ❌ $name FAILED"
    cat "$tmpdir/${key}.log"
    failed=1
  fi
done

# ═══════════════════════════════════════════════════════════════════
# Phase 2+3: Backend (pytest) ∥ Frontend (vitest), run in parallel.
#
# The full vitest suite takes ~4-5 min, which blows normal commit
# timeouts. Frontend scoping (override with GATE_FULL=1 for a forced
# full run):
#   1. staged frontend test files          → run exactly those files
#   2. no staged app/src changes at all    → skip frontend tests
#   3. staged app/src source changed       → colocated tests per changed
#      file, PLUS a core-path floor covering shared seams (ui primitives,
#      platform/toast wiring, store, settings updater)
# CI runs the full suite; the gate optimizes for fast, honest feedback.
# ═══════════════════════════════════════════════════════════════════

echo ""
echo "Phase 2+3: Backend + Frontend tests (parallel)..."

BACKEND_TEST_FILES=(
  backend/tests/test_tool_registry.py
  backend/tests/test_tr_dispatch.py
  backend/tests/test_stt_backends.py
  backend/tests/test_stt_self_check.py
  backend/tests/test_generation_subfunctions.py
  backend/tests/test_items_4_5_6.py
  backend/tests/test_items_7_8_9.py
  backend/tests/test_verify_system.py
)

CORE_FLOOR_STR="src/ui/ui.test.tsx src/hooks/useAutoUpdater.test.tsx src/features/store/storeUtils.test.ts src/features/store/StorePage.test.tsx src/features/settings/GeneralPage.test.tsx"

changed_tests=$(git diff --cached --name-only --diff-filter=ACM -- \
  'app/src/**/*.test.ts' 'app/src/**/*.test.tsx' \
  'app/src/**/*.spec.ts' 'app/src/**/*.spec.tsx')
changed_src=$(git diff --cached --name-only --diff-filter=ACM -- 'app/src' \
  | grep -vE '\.(test|spec)\.(ts|tsx)$' || true)

frontend_mode="full"
frontend_files=""
if [ -n "${GATE_FULL:-}" ]; then
  frontend_mode="full"
elif [ -z "$changed_tests" ] && [ -z "$changed_src" ]; then
  frontend_mode="skip"
else
  # Scoped = directly staged tests ∪ tests colocated with staged source
  # files ∪ the shared-seam core floor. Any app/src change lands here.
  colocated=""
  for f in $changed_src; do
    dir=${f%/*}; base=${f##*/}; stem=${base%.*}
    for ext in test.ts test.tsx spec.ts spec.tsx; do
      [ -f "$root/$dir/$stem.$ext" ] && colocated="$colocated ${dir#app/}/$stem.$ext"
    done
  done
  frontend_mode="scoped"
  frontend_files="$CORE_FLOOR_STR $(printf '%s ' $changed_tests | sed 's| app/| |g') $colocated"
fi
if [ "$frontend_mode" = "scoped" ]; then
  frontend_files=$(printf '%s\n' $frontend_files | awk '!seen[$0]++' | paste -sd' ' -)
  [ -z "$frontend_files" ] && frontend_mode="full"
fi

vitest_timeout=300
[ "$frontend_mode" = "full" ] && vitest_timeout=600

(
  cd "$root" || exit 1
  timeout 90 $PY -X utf8 -m pytest "${BACKEND_TEST_FILES[@]}" \
      -q --tb=line --no-header --timeout=15 \
      2>&1 | tail -10
  echo $? > "$tmpdir/pytest.rc"
) > "$tmpdir/pytest.log" 2>&1 &
pid_pytest=$!

(
  cd "$root/app" || exit 1
  case "$frontend_mode" in
    skip)
      echo "skipped: no staged app/src changes"
      echo 0 > "$tmpdir/vitest.rc" ;;
    scoped)
      echo "scoped: $frontend_files"
      # shellcheck disable=SC2086
      timeout $vitest_timeout $VITEST run --reporter=dot $frontend_files \
        2>&1 | tail -10
      echo $? > "$tmpdir/vitest.rc" ;;
    full)
      timeout $vitest_timeout $VITEST run --reporter=dot \
        2>&1 | tail -10
      echo $? > "$tmpdir/vitest.rc" ;;
  esac
) > "$tmpdir/vitest.log" 2>&1 &
pid_vitest=$!

wait $pid_pytest 2>/dev/null
wait $pid_vitest 2>/dev/null

if [ "$(cat "$tmpdir/pytest.rc" 2>/dev/null || echo 1)" -eq 0 ]; then
  echo "  ✅ Backend tests passed"
else
  echo "  ❌ Backend tests FAILED"
  cat "$tmpdir/pytest.log"
  failed=1
fi

if [ "$frontend_mode" = "skip" ]; then
  echo "  ⏭️ Frontend tests skipped (no staged app/src changes)"
elif [ "$(cat "$tmpdir/vitest.rc" 2>/dev/null || echo 1)" -eq 0 ]; then
  echo "  ✅ Frontend tests passed ($frontend_mode)"
else
  echo "  ❌ Frontend tests FAILED"
  cat "$tmpdir/vitest.log"
  failed=1
fi
[ "$frontend_mode" = "scoped" ] && echo "  ↳ scope: $frontend_files (GATE_FULL=1 forces the full run)"

# ═══════════════════════════════════════════════════════════════════
# Summary
# ═══════════════════════════════════════════════════════════════════

echo ""
echo "============================================"
if [ $failed -ne 0 ]; then
  echo "  ❌ PRE-COMMIT GATE FAILED"
  echo "  Fix the errors above, then re-commit"
  echo "  Auto-fix: bin/check.ps1 -Fix  or  just fix"
  echo "============================================"
  exit 1
else
  echo "  ✅ ALL CHECKS PASSED (11/11)"
  echo "============================================"
  exit 0
fi
