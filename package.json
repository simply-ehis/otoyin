{
	"name": "otoyin",
	"version": "0.1.0",
	"private": true,
	"workspaces": [
		"app",
		"tauri",
		"docs"
	],
	"scripts": {
		"dev": "cd tauri && npm run tauri dev",
		"dev:landing": "cd landing && npm run dev",
		"dev:server": "uvicorn backend.main:app --reload --port 17493",
		"setup": "node scripts/setup-dev.js",
		"build:server": "bash scripts/build-server.sh",
		"download:models": "python -m backend.scripts.download_required_models",
		"build:landing": "cd landing && npm run build",
		"lint": "biome lint .",
		"lint:fix": "biome lint --write .",
		"typecheck": "cd app && tsc -p tsconfig.json --noEmit",
		"format": "biome format --write .",
		"format:check": "biome format .",
		"check": "biome check .",
		"check:fix": "biome check --write ."
	},
	"dependencies": {
		"@neon/config": "^1.7.3"
	},
	"overrides": {
		"@types/react-dom": "^19.2.4"
	},
	"devDependencies": {
		"@biomejs/biome": "2.3.12"
	},
	"engines": {
		"node": ">=18.0.0"
	}
}
